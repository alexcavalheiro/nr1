# ===== Banco de dados =====
# Local (dev): deixe em branco para usar PGlite (Postgres em WASM, sem instalar nada).
# Produção (Supabase): cole a connection string do Supabase aqui.
#   Settings → Database → Connection string → URI (use a "Transaction"/pooler para a app).
DATABASE_URL="postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres"

# Segredo para assinar a sessão (gere algo aleatório: `openssl rand -hex 32`).
SESSION_SECRET="troque-por-uma-chave-aleatoria-longa"

# (Opcional) Chave da Anthropic para ativar o Copiloto com IA generativa real.
# Sem isso, o assistente funciona em "Modo Local" (respostas baseadas nos dados).
ANTHROPIC_API_KEY=""
# Modelo (default: claude-opus-4-8 — o mais capaz). Para reduzir custo/latência,
# use claude-sonnet-4-6 ou claude-haiku-4-5.
# ANTHROPIC_MODEL="claude-opus-4-8"
# Ajustes finos opcionais da chamada:
# ANTHROPIC_MAX_TOKENS="2048"
# ANTHROPIC_TIMEOUT_MS="60000"
# ANTHROPIC_MAX_RETRIES="2"
